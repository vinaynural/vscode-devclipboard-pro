{
  "name": "devclipboard-pro",
  "displayName": "DevClipboard Pro",
  "description": "A production-grade, unified clipboard manager for VS Code with terminal and panel support.",
  "version": "1.0.0",
  "publisher": "dev-essentials",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinaynural/vscode-devclipboard-pro.git"
  },
  "keywords": [
    "clipboard",
    "manager",
    "history",
    "productivity",
    "terminal"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devClipboard.openPanel",
        "title": "DevClipboard: Open Clipboard Panel",
        "category": "DevClipboard"
      },
      {
        "command": "devClipboard.clearHistory",
        "title": "DevClipboard: Clear History",
        "category": "DevClipboard"
      },
      {
        "command": "devClipboard.pinItem",
        "title": "DevClipboard: Pin Item",
        "category": "DevClipboard"
      },
      {
        "command": "devClipboard.deleteItem",
        "title": "DevClipboard: Delete Item",
        "category": "DevClipboard"
      },
      {
        "command": "devClipboard.pasteStructured",
        "title": "DevClipboard: Paste Structured Data",
        "category": "DevClipboard"
      },
      {
        "command": "devClipboard.exportHistory",
        "title": "DevClipboard: Export History",
        "category": "DevClipboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dev-clipboard-explorer",
          "title": "DevClipboard Pro",
          "icon": "$(clippy)"
        }
      ]
    },
    "views": {
      "dev-clipboard-explorer": [
        {
          "type": "webview",
          "id": "devclipboard.sidebar",
          "name": "History",
          "icon": "$(history)"
        }
      ]
    },
    "configuration": {
      "title": "DevClipboard Pro",
      "properties": {
        "devClipboard.maxHistorySize": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of clipboard entries to store."
        },
        "devClipboard.autoDeleteAfterDays": {
          "type": "number",
          "default": 30,
          "description": "Automatically delete entries older than this many days."
        },
        "devClipboard.enableTerminalCapture": {
          "type": "boolean",
          "default": true,
          "description": "Enable capturing copies from the integrated terminal."
        },
        "devClipboard.enableClassification": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic language/type detection."
        },
        "devClipboard.enableEncryption": {
          "type": "boolean",
          "default": false,
          "description": "Enable AES-256-GCM encryption for stored entries."
        },
        "devClipboard.pollingIntervalMs": {
          "type": "number",
          "default": 800,
          "description": "Interval for polling the system clipboard (fallback mechanism)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "tsx ./scripts/build.ts",
    "build:prod": "tsx ./scripts/build.ts --production",
    "watch": "tsx ./scripts/build.ts --watch",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node ./node_modules/@vscode/test-electron/bin/test",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\" \"webview-ui/src/**/*.{tsx,ts,css}\""
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "fuse.js": "^7.0.0",
    "lru-cache": "^10.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "shiki": "^1.1.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  }
}
